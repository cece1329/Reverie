<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: digunakan untuk activity biasa -->
    <style name="Theme.Reverie" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme: digunakan saat aplikasi pertama dibuka -->
    <style name="Theme.Reverie.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0B1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logoloading</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Reverie</item>
    </style>
</resources>
